{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEO Audit",
  "version": "1.34.0",
  "identifier": "com.nurkamol.seo-audit.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage",
      "deb"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "engine": "engine"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Crawl a site's sitemap and check every page",
    "longDescription": "Crawls every page a sitemap lists, not just the homepage, and reports the SEO, metadata and structured-data problems single-page graders miss. Nothing leaves the machine."
  }
}
