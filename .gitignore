build/

# SwiftPM build artifacts. 177 MB of them reached the repository once,
# which matters more than repo size: `npx github:nurkamol/seo-audit` clones
# this, and the whole promise is that it is small enough to run that way.
.build/

# Rust build artifacts, for the same reason the SwiftPM ones are ignored:
# `npx github:nurkamol/seo-audit` clones this repository, and a gigabyte of
# object files is a gigabyte somebody downloads to run one command.
desktop/src-tauri/target/
# Generated by `tauri build` from tauri.conf.json; not a source file.
desktop/src-tauri/gen/
# Staged into the bundle by desktop/scripts/prepare.mjs: a 110 MB Node and a
# copy of the engine. Both are built from things already in this repository.
desktop/src-tauri/binaries/
desktop/src-tauri/engine/
