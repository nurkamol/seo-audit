{
  "name": "seo-audit",
  "version": "0.1.0",
  "description": "Crawl a site's sitemap and check every page for the SEO and metadata problems single-page graders miss",
  "type": "module",
  "bin": { "seo-audit": "bin/seo-audit.mjs" },
  "exports": { ".": "./src/audit.mjs" },
  "files": ["bin", "src", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "audit": "node bin/seo-audit.mjs"
  },
  "keywords": ["seo", "audit", "crawler", "sitemap", "metadata", "open-graph", "hreflang", "cli"],
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/nurkamol/seo-audit.git" }
}
